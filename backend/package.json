{
  "name": "badshah-customer-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "db:test": "node scripts/db-test.js",
    "db:verify": "node scripts/verify-mongo.js",
    "db:local": "node scripts/dev-mongo.js",
    "db:migrate:sqlite-to-mongo": "node scripts/migrate-sqlite-to-mongo.js",
    "db:migrate:sqlite-to-mongo:dry": "node scripts/migrate-sqlite-to-mongo.js --dry-run",
    "images:migrate:cloudinary": "node scripts/migrate-images-to-cloudinary.js"
  },
  "dependencies": {
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mongodb": "^6.22.0",
    "multer": "^2.0.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3"
  }
}
