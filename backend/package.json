{
  "name": "badshah-customer-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "db:test": "node scripts/db-test.js",
    "db:migrate:sqlite-to-postgres": "node scripts/migrate-sqlite-to-postgres.js",
