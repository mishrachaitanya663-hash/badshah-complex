# Badshah Complex backend configuration
# Copy to .env and fill values for your environment. Never commit .env.

# --- Server ---
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5175,http://localhost:5176

# --- Database ---
# DB_DRIVER: sqlite (local) or postgres (production-ready)
DB_DRIVER=sqlite
# SQLite (used when DB_DRIVER=sqlite)
SQLITE_FILE=./data/badshah-customer.db
# PostgreSQL (used when DB_DRIVER=postgres)
# Example: postgresql://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_URL=
# Optional: set PGSSLMODE=disable for local/non-SSL Postgres
# PGSSLMODE=disable

# --- Admin bootstrap (used only to create first admin if none exists) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_TTL_HOURS=8

# --- Uploads / images ---
# Local upload directory (used as fallback when Cloudinary is not configured)
UPLOAD_DIR=./uploads
MAX_IMAGE_MB=5

# --- Cloudinary (recommended for production; keep secrets on backend only) ---
# Leave empty to use local /uploads storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
