# Badshah Complex backend configuration
# Copy to .env and fill values for your environment. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5175,http://localhost:5176

# --- Database (MongoDB) ---
# DB_DRIVER: mongo (also accepts mongodb)
DB_DRIVER=mongo
# MongoDB Atlas free cluster or local MongoDB instance
# Local free development: run `npm run db:local` and use the URI below.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=badshah_custmer
# Optional: DNS resolvers used for mongodb+srv:// URIs. Defaults to public DNS.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
# Optional: only for explicit-host URIs with a CNAME/TLS target mismatch.
# Do not set this with mongodb+srv:// URIs.
MONGODB_TLS_SERVERNAME=

# --- Admin bootstrap (applied on every backend start) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-with-at-least-12-chars
SESSION_TTL_HOURS=8

# --- Uploads / images ---
# Local upload directory (used as fallback when Cloudinary is not configured)
UPLOAD_DIR=./uploads
MAX_IMAGE_MB=5

# --- Cloudinary (recommended for production; keep secrets on backend only) ---
# Leave empty to use local /uploads storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
